# systemd EnvironmentFile syntax (not a shell script); optional overrides.
# Install as /etc/lan-jukebox/server.env; consumed by all three services.
MPD_HOST=127.0.0.1
MPD_PORT=6600
STREAM_HOST=127.0.0.1
STREAM_PORT=8000
STREAM_OUTPUT="FLAC LAN Stream"
# 1: if stopped with a nonempty queue and no listener, play to bind httpd.
# 0: respect stopped state even though the music client cannot connect yet.
START_STOPPED=1
# MPD_SERVICE and RECOVERY_DIR are intentionally not exposed here: changing
# those script defaults requires corresponding edits to the unit topology.
